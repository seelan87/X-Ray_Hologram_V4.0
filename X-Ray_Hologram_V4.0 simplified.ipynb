    "        self._tab7_view_nm = self._tab7_mouse_zoom_view\n",
    "        self._tab7_roi_zoomed = False\n",
    "        self.line_profile_canvas_image.draw_idle()\n",
    "    except Exception:\n",
    "        pass\n",
    "_TAB7_ZOOM_BUILD_OLD = CDIWorkflowApp._build_ui\n",
