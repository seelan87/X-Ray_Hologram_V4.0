    "            return v if v is not None else _old_tab5_final_getter(self)\n",
    "        CDIWorkflowApp._tab5_final_primary_nm_per_pixel = _tab5_final_primary_nm_per_pixel_final\n",
    "except Exception:\n",
    "    pass\n",
    "if hasattr(CDIWorkflowApp, '_pixel_cal_apply_direct'):\n",
