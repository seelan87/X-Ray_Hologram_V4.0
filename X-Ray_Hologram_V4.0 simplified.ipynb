    "    self.pd_image_artist_gray = self.pd_ax_gray.imshow(np.zeros((2, 2)), cmap='gray', origin='lower', vmin=0, vmax=1, interpolation='nearest', extent=(-0.5, 1.5, -0.5, 1.5))\n",
