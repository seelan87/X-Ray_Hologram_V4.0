    "        ttk.Label(param_box, textvariable=var, justify='right').grid(row=r, column=1, sticky='e', pady=2)\n",
    "    self.tab10_param_vars['status'] = tk.StringVar(value='Gaussian fit not performed.')\n",
    "\n",
