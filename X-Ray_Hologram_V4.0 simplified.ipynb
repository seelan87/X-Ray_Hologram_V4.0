    "    wrap.grid(row=2,column=0,sticky=\"nsew\")\n",
    "    wrap.grid_rowconfigure(0,weight=1);wrap.grid_columnconfigure(0,weight=1)\n",
    "    pc=tk.Canvas(wrap,highlightthickness=0,borderwidth=0)\n",
