    "        ('r2', 'R²'), ('rmse', 'RMSE'), ('line_rmse', 'Line RMSE'), ('line_cv', 'Line CV'),\n",
    "        ('fov', 'ROI4 FOV'), ('frame', 'Frame'), ('field', 'Equivalent field')\n",
    "    ]\n",
