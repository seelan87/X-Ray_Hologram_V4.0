    "    ax.set_autoscale_on(False)\n",
    "    ax.set_xlim(nxmin, nxmax)\n",
    "    ax.set_ylim(nymin, nymax)\n",
    "    ax.set_aspect('equal', adjustable='box')\n",
    "    ax.set_anchor('C')\n",
    "    canvas.draw_idle()\n",
    "\n",
