    "    canvas.mpl_connect('button_press_event', self._proc_profile_on_press)\n",
    "    canvas.mpl_connect('motion_notify_event', self._proc_profile_on_move)\n",
    "    canvas.mpl_connect('button_release_event', self._proc_profile_on_release)\n",
    "    try:\n",
    "        self._proc_update()\n",
    "    except Exception:\n",
    "        pass\n",
