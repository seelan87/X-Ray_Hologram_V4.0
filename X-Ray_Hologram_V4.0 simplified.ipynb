    "    nymin = cy - ry * nwy\n",
    "    nymax = nymin + nwy\n",
    "    if nxmin < fx0:\n",
    "        d = fx0 - nxmin\n",
    "        nxmin += d\n",
    "        nxmax += d\n",
    "    if nxmax > fx1:\n",
    "        d = nxmax - fx1\n",
    "        nxmin -= d\n",
    "        nxmax -= d\n",
    "    if nymin < fy0:\n",
    "        d = fy0 - nymin\n",
    "        nymin += d\n",
    "        nymax += d\n",
    "    if nymax > fy1:\n",
    "        d = nymax - fy1\n",
    "        nymin -= d\n",
    "        nymax -= d\n",
    "    if nxmax - nxmin >= 0.999999 * (fx1 - fx0) and nymax - nymin >= 0.999999 * (fy1 - fy0):\n",
    "        self._line_profile_zoomed = False\n",
    "        self._line_profile_zoom_limits = None\n",
    "        ax.set_xlim(fx0, fx1)\n",
    "        ax.set_ylim(fy0, fy1)\n",
